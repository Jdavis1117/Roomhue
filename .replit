entrypoint = "app/main.py"
language = "python3"
modules = ["python-3.11"]
run = "python3 -m uvicorn app.main:app --host 0.0.0.0 --port 8765"

[nix]
channel = "stable-24_05"

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

[packager]
language = "python3"

[packager.features]
guessImports = false
enabledForHosting = false

[deployment]
build = ["sh", "-c", "PIP_USER=false python3 -m pip install --prefix \"$PWD/.pythonlibs\" -r requirements.txt"]
run = ["python3", "-m", "uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8765"]
deploymentTarget = "cloudrun"

[[ports]]
localPort = 8765
externalPort = 80

[objectStorage]
defaultBucketID = "replit-objstore-096a6799-617d-43b3-938d-a45a4159d073"

[userenv]

[userenv.shared]
PIP_PREFIX = ".pythonlibs"
PIP_USER = "false"
